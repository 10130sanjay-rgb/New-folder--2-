<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Event_Overbooking</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Registration_Status__c, &quot;Registered&quot;),
    Event__r.Registered_Count__c &gt;= Event__r.Capacity__c
)</errorConditionFormula>
    <errorMessage>Event is full. Registration cannot be completed.</errorMessage>
</ValidationRule>
